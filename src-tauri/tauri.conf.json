{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autopilotmode",
  "version": "0.1.1",
  "identifier": "com.autopilotmode.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "autopilotmode",
        "width": 420,
        "height": 208,
        "minWidth": 360,
        "minHeight": 196,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
