# ── autopilotmode configuration ──────────────────────────────────────────
# Copy to `.env` (which is git-ignored) and fill in your key.
#
# You do not have to edit this file by hand. The desktop app's settings pane reads and
# writes this same file — it only touches the lines it owns, so these comments survive.
#
# QUOTE ANY VALUE CONTAINING SPACES OR BRACKETS:
#     AUTOPILOT_MIC="Headset Microphone (USB)"     ✅
#     AUTOPILOT_MIC=Headset Microphone (USB)       ❌ breaks parsing
# An unparseable line does not fail on its own — it aborts the rest of the file, silently
# taking every setting *below* it with it. That reads as "my API key stopped working".
#
# Renamed from `robotmouse`: the old `ROBOTMOUSE_*` names are still read as a fallback, so
# an existing `.env` keeps working. New setups should use `AUTOPILOT_*`.

# ── Anthropic credential (required) ──────────────────────────────────────
# Either an API key or an OAuth access token — the client detects which from the prefix and
# sends the right header for it.
#
# An API key (`sk-ant-api...`) bills against pay-as-you-go API credits. Note that a Claude
# Pro/Max subscription does NOT fund this: claude.ai and Claude Code are covered by the
# subscription, but a program calling /v1/messages is separate, metered API usage.
ANTHROPIC_API_KEY=sk-ant-api...

# Alternative: a subscription-backed OAuth token (`sk-ant-oat...`) from the `ant` CLI.
# Install `ant`, run `ant auth login`, then:
#   ANTHROPIC_AUTH_TOKEN=$(ant auth print-credentials --access-token)
# Tokens are short-lived, so this needs refreshing for long sessions. Whether your plan
# entitles a third-party program to use it is between you and your subscription terms.
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat...

# The loader also accepts CLAUDELLM / AUTOPILOT_API_KEY / CLAUDE_API_KEY.

# Model driving the loop. Change this the day a newer model ships; no code edit needed.
AUTOPILOT_MODEL=claude-opus-5

# ── model tuning ─────────────────────────────────────────────────────────
# Reasoning depth: low | medium | high | xhigh | max, or `none` to omit the field.
#
# Claude Opus 5 thinks by default at `high` effort — seconds of deliberation before every
# click. This loop takes one small action per screenshot and re-checks its work on the next
# frame, which is the shape low effort handles well, so `low` is the default here rather
# than the API's. Raise it if the model misreads the screen or picks poor targets.
#
# `effort` is an Opus/Sonnet-tier parameter; Haiku rejects it. You do not normally need to
# set `none` — the client notices the rejection once per model and stops sending it.
# AUTOPILOT_EFFORT=low

# Escalation model, used ONLY for the few steps after the loop stops making progress.
#
# A fast model handles ordinary steering well and roughly halves the round trip; reasoning
# out of a wedged position is where extra capability actually pays. Leave unset for
# single-model operation. See "Two models" in the README.
# AUTOPILOT_MODEL_HEAVY=claude-opus-5

# Anthropic fast mode: the same model, generating output up to ~2.5x faster, at premium
# rates ($10/$50 per MTok vs $5/$25). `--game` enables it automatically; set 0 to opt out.
# Availability is account-gated and it draws on a separate rate-limit pool — if it is
# unavailable the client falls back to standard speed on its own and keeps going.
# AUTOPILOT_FAST_MODE=1

# ── voice (desktop app only, all optional) ───────────────────────────────
# ElevenLabs key. Required for the MICROPHONE (speech → text). Spoken replies do NOT need
# it — those use your system voice for free; the key only buys a better-sounding one.
# Also accepted: ELEVENLABS_API_KEY / ELEVENLABS_KEY / ELEVENLABSAPI / ELEVEN_API_KEY.
# AUTOPILOT_ELEVENLABS_KEY=sk_...

# Speak results out loud. 1 = on, unset = off.
# Only outcomes are spoken, never each step — narrating every action would talk over
# whatever the agent is driving.
# AUTOPILOT_VOICE=1

# Which voice speaks: unset = your system voice (free, no key), or `elevenlabs`.
# AUTOPILOT_VOICE_ENGINE=elevenlabs

# ElevenLabs voice id. Unset uses a stock voice. Pick one in the settings pane instead —
# it lists the voices on your own account.
# AUTOPILOT_VOICE_ID=

# Which microphone to listen on. Unset = system default.
# QUOTE IT — device names almost always contain spaces and brackets.
# AUTOPILOT_MIC="Headset Microphone (USB Audio Device)"

# ── optional tunables (defaults shown) ───────────────────────────────────
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AUTOPILOT_MAX_STEPS=25             # cap on observe→act iterations
# AUTOPILOT_MAX_IMAGE_DIM=1280       # longest edge (px) of screenshots sent to the model
# AUTOPILOT_ACTION_DELAY_MS=600      # pause after each action before re-screenshotting
# AUTOPILOT_KEEP_SCREENSHOTS=3       # recent screenshots kept in context (older = trimmed)
# AUTOPILOT_MONITOR=0                # which monitor to capture/drive
# AUTOPILOT_IMAGE_FORMAT=png         # png | jpeg — jpeg uploads faster
# AUTOPILOT_MOUSE_SPEED=1.0          # pointer travel multiplier (0.25 - 8.0)
# AUTOPILOT_HUMAN_MOUSE=1            # 0 = teleport the cursor instead of gliding
# AUTOPILOT_TERSE=0                  # 1 = skip narration, keep `reason` to a few words
# AUTOPILOT_SHOW_TIMING=1            # 0 = hide the per-step timing/token line
# AUTOPILOT_YES=1                    # skip the startup confirmation prompt
